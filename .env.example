# The discovery service's own environment. Two of these are secrets and neither
# belongs in a shell command — put them in the Railway service's variables, or
# in a .env file this directory's .gitignore already covers.

# --- the model ---------------------------------------------------------------

# Google AI Studio. The service refuses every request without it and says so on
# /healthz, rather than failing on the first search of a run.
GEMINI_API_KEY=

# What the old portal used. Changeable without a code edit because the model is
# the part of this most likely to be replaced.
GEMINI_MODEL=gemini-3.7-flash

# --- the shared secret ------------------------------------------------------
#
# Required on every route but /healthz, and the same value has to be set as
# DISCOVERY_TOKEN on the API service. Without it this instance serves nothing:
# it holds a Gemini key and a search tool, and a Railway URL is not a secret.
#
# Generate one with:  openssl rand -base64 32
DISCOVERY_TOKEN=

# --- run shape --------------------------------------------------------------
#
# How many search hits per query are worth classifying. Each URL costs a
# classify call and possibly an extract call, both 30-60 seconds, so this is
# the main lever on how long a run takes:
#
#     15 queries x 10 URLs x ~90s  =  the "about thirty minutes" figure
#
# Lower it for a faster, shallower sweep.
DISCOVERY_MAX_URLS_PER_QUERY=10

# Set to `production` to hide /docs. Anything else serves the interactive docs,
# which are useful locally and are a description of how to spend the key
# otherwise.
ENV=development
